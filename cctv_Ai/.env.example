# ============================================================
# CAMERA / NVR CONFIGURATION
# ============================================================
# Preferred format: IP|channel|camera name|area, separated by commas.
# Add every physical camera that should appear in the dashboard.
# Keep the real password only in local .env.
CAMERA_CONFIG=192.168.0.241|1|Camera 241|Camera 1 Area,192.168.0.242|1|Camera 242|Camera 2 Area,192.168.0.252|1|Camera 252|Camera 3 Area,192.168.0.246|1|Camera 246|Camera 4 Area,192.168.0.253|1|Camera 253|Camera 5 Area,192.168.0.249|1|Camera 249|Camera 6 Area,192.168.1.157|1|Vallarmathi 1|Vallarmathi,192.168.1.158|1|Vallarmathi 2|Vallarmathi,192.168.1.159|1|Vallarmathi 3|Vallarmathi,192.168.1.160|1|Vallarmathi 4|Vallarmathi,192.168.1.165|1|Prasana Honda 1|Prasana Honda,192.168.1.166|1|Prasana Honda 2|Prasana Honda,192.168.1.167|1|Prasana Honda 3|Prasana Honda,192.168.1.168|1|Prasana Honda 4|Prasana Honda,192.168.1.125|1|Dhadikkaramukku 1|Dhadikkaramukku,192.168.1.126|1|Dhadikkaramukku 2|Dhadikkaramukku,192.168.1.127|1|Dhadikkaramukku 3|Dhadikkaramukku,192.168.1.128|1|Dhadikkaramukku 4|Dhadikkaramukku,192.168.1.129|1|Parapalayam JN 1|Parapalayam JN,192.168.1.130|1|Parapalayam JN 2|Parapalayam JN,192.168.1.131|1|Parapalayam JN 3|Parapalayam JN,192.168.1.132|1|Parapalayam JN 4|Parapalayam JN,192.168.1.133|1|Chinnandi palayam 1|Chinnandi palayam,192.168.1.134|1|Chinnandi palayam 2|Chinnandi palayam,192.168.1.135|1|Chinnandi palayam 3|Chinnandi palayam,192.168.1.136|1|Chinnandi palayam 4|Chinnandi palayam,192.168.1.138|1|Karaithottam 2|Karaithottam,192.168.1.139|1|Karaithottam 3|Karaithottam,192.168.1.140|1|Karaithottam 4|Karaithottam,192.168.1.141|1|Ayyampalayam 1|Ayyampalayam,192.168.1.142|1|Ayyampalayam 2|Ayyampalayam,192.168.1.143|1|Ayyampalayam 3|Ayyampalayam,192.168.1.144|1|Ayyampalayam 4|Ayyampalayam,192.168.1.147|1|TKT Mill 3|TKT Mill,192.168.1.169|1|Benny Complex 1|Benny Complex,192.168.1.170|1|Benny Complex 2|Benny Complex,192.168.1.171|1|Benny Complex 3|Benny Complex,192.168.1.172|1|Benny Complex 4|Benny Complex,192.168.1.173|1|Rayapuram 1|Rayapuram,192.168.1.174|1|Rayapuram 2|Rayapuram,192.168.1.175|1|Rayapuram 3|Rayapuram,192.168.1.176|1|Rayapuram 4|Rayapuram,192.168.1.177|1|Crystal JN 1|Crystal JN,192.168.1.178|1|Crystal JN 2|Crystal JN,192.168.1.179|1|Crystal JN 3|Crystal JN,192.168.1.180|1|Crystal JN 4|Crystal JN,192.168.1.121|1|Koolipalayam 1|Koolipalayam,192.168.1.122|1|Koolipalayam 2|Koolipalayam,192.168.1.123|1|Koolipalayam 3|Koolipalayam,192.168.1.124|1|Koolipalayam 4|Koolipalayam,192.168.1.161|1|Neruperichal 1|Neruperichal,192.168.1.162|1|Neruperichal 2|Neruperichal,192.168.1.163|1|Neruperichal 3|Neruperichal,192.168.1.164|1|Neruperichal 4|Neruperichal,192.168.1.80|1|Pandian Nagar 1|Pandian Nagar,192.168.1.81|1|Pandian Nagar 2|Pandian Nagar,192.168.1.82|1|Pandian Nagar 3|Pandian Nagar,192.168.1.83|1|Pandian Nagar 4|Pandian Nagar,192.168.1.203|1|A.palayam Gov School 1|A.palayam Gov School,192.168.1.204|1|A.palayam Gov School 2|A.palayam Gov School,192.168.1.205|1|A.palayam Gov School 3|A.palayam Gov School,192.168.1.206|1|A.palayam Gov School 4|A.palayam Gov School,192.168.1.207|1|Soolipalayam Road 15VMP 1|Soolipalayam Road 15VMP,192.168.1.208|1|Soolipalayam Road 15VMP 2|Soolipalayam Road 15VMP,192.168.1.209|1|Soolipalayam Road 15VMP 3|Soolipalayam Road 15VMP,192.168.1.210|1|Soolipalayam Road 15VMP 4|Soolipalayam Road 15VMP,192.168.1.213|1|25 Mukku 15VMP|25 Mukku 15VMP,192.168.1.223|1|TMF Hospital Bridge 1|TMF Hospital Bridge,192.168.1.224|1|TMF Hospital Bridge 2|TMF Hospital Bridge,192.168.1.225|1|TMF Hospital Bridge 3|TMF Hospital Bridge,192.168.1.226|1|TMF Hospital Bridge 4|TMF Hospital Bridge

# Legacy fallback. Used only when CAMERA_CONFIG is empty.
CAMERA_IPS=192.168.0.241,192.168.0.242
CAMERA_AREAS=Camera 1 Area,Camera 2 Area

CAMERA_USERNAME=admin
CAMERA_PASSWORD=your_password_here
CAMERA_SUBTYPE=0

# Optional second credential group for recorder/NVR IPs.
# Keep real passwords only in local .env; never commit them.
RECORDER_CAMERA_IPS=192.168.0.252,192.168.0.246,192.168.0.253,192.168.0.249
RECORDER_CAMERA_USERNAME=admin
RECORDER_CAMERA_PASSWORD=your_recorder_password_here

# ============================================================
# PRIMARY YOLO + BYTETRACK
# ============================================================
YOLO_MODEL=yolov8n.pt
TRACKING_CANDIDATE_CONFIDENCE=0.28
IOU_THRESHOLD=0.45
TARGET_CLASSES=0,1,2,3,5,7
# Large camera deployments are CPU/GPU intensive. Start low and increase only
# after checking system load and stream latency.
AI_MAX_FPS=1
YOLO_IMGSZ=640
YOLO_DEVICE=
TRACK_TRAIL_LENGTH=18
JPEG_QUALITY=80

# ============================================================
# VEHICLE COUNTING
# ============================================================
COUNTING_ENABLED=1
COUNT_LINE_Y_RATIO=0.62
COUNT_MIN_TRACK_AGE=3
COUNT_MIN_CONFIDENCE=0.35

# ============================================================
# MYSQL
# ============================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cctv_ai
DB_USER=root
DB_PASSWORD=

# ============================================================
# ADVANCED MODELS
# ============================================================
HELMET_MODEL=models/helmet.pt
PLATE_MODEL=models/license_plate.pt
ROAD_DAMAGE_MODEL=models/road_damage.pt
# Optional model. If present, its detections are also shown in the Incidents page.
ROAD_OBSTRUCTION_MODEL=models/road_obstruction.pt
ADVANCED_DETECTION_ENABLED=1
ADVANCED_EVERY_N_FRAMES=3
ADVANCED_CONFIDENCE=0.35

# ============================================================
# HELMET
# ============================================================
HELMET_OBSERVATION_CONFIDENCE=0.25
HELMET_CONFIDENCE=0.45
NO_HELMET_CONFIDENCE=0.68
NO_HELMET_FINAL_AVG_CONFIDENCE=0.48
HELMET_IMGSZ=960
HELMET_CONFIRM_FRAMES=3
HELMET_CONFIRM_WINDOW=7
STRICT_NO_HELMET_MIN_CONFIDENCE=0.68
STRICT_NO_HELMET_CONFIRM_FRAMES=3
STRICT_NO_HELMET_VOTE_RATIO=0.60
HELMET_CONFLICT_MARGIN=0.12
FALLBACK_NO_HELMET_CONFIDENCE=0.72
FALLBACK_NO_HELMET_FINAL_AVG_CONFIDENCE=0.52
FALLBACK_NO_HELMET_CONFIRM_FRAMES=3
FALLBACK_NO_HELMET_VOTE_RATIO=0.80

# ============================================================
# LICENSE PLATE + OCR
# ============================================================
PLATE_CONFIDENCE=0.20
PLATE_IMGSZ=960
PLATE_OCR_MIN_CONFIDENCE=0.18
PLATE_CACHE_SECONDS=8
PLATE_CONFIRM_READS=2
PLATE_CONFIRM_WINDOW=5
OCR_ENABLED=1

# ============================================================
# ROAD DAMAGE
# ============================================================
ROAD_DAMAGE_CONFIDENCE=0.25
ROAD_DISPLAY_CONFIDENCE=0.12
ROAD_DAMAGE_IMGSZ=960
ROAD_EVERY_N_FRAMES=5
ROAD_ROI_TOP_RATIO=0.22
ROAD_TILE_COLUMNS=2
ROAD_TILE_OVERLAP=0.18

# ============================================================
# ACCIDENT + ROAD OBSTRUCTION INCIDENT DETECTION
# ============================================================
INCIDENT_DETECTION_ENABLED=1
INCIDENT_EVERY_N_FRAMES=3

# Accident heuristic uses existing YOLO + ByteTrack vehicle tracks.
ACCIDENT_DETECTION_ENABLED=1
ACCIDENT_CONFIRM_FRAMES=2
ACCIDENT_CONFIRM_WINDOW=5
ACCIDENT_MIN_MOTION_RATIO=0.055
ACCIDENT_STOP_RATIO=0.45
ACCIDENT_PROXIMITY_RATIO=0.70
ACCIDENT_IOU_THRESHOLD=0.03
ACCIDENT_COOLDOWN_SECONDS=120

# Model-free fallback for fallen tree / branch / debris / other persistent blockage.
# It learns the fixed-camera background and only reports a newly persistent region
# inside the lower roadway ROI. A dedicated road_obstruction.pt can still be used.
ROAD_OBSTRUCTION_FALLBACK_ENABLED=1
OBSTRUCTION_EVERY_N_FRAMES=5
OBSTRUCTION_ROI_TOP_RATIO=0.28
OBSTRUCTION_MIN_AREA_RATIO=0.012
OBSTRUCTION_CONFIRM_FRAMES=10
OBSTRUCTION_COOLDOWN_SECONDS=180
OBSTRUCTION_LEARNING_RATE=0.0005
OBSTRUCTION_WARMUP_FRAMES=45

# ============================================================
# COOLDOWNS
# ============================================================
VIOLATION_COOLDOWN_SECONDS=90
ROAD_EVENT_COOLDOWN_SECONDS=120
