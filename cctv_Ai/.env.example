# ============================================================
# CAMERA / NVR CONFIGURATION
# ============================================================
# Preferred format: IP|channel|camera name|area, separated by commas.
# Add every physical channel that should appear in the dashboard.
CAMERA_CONFIG=192.168.0.241|1|Camera 241|Camera 1 Area,192.168.0.242|1|Camera 242|Camera 2 Area

# Legacy fallback. Used only when CAMERA_CONFIG is empty.
CAMERA_IPS=192.168.0.241,192.168.0.242
CAMERA_AREAS=Camera 1 Area,Camera 2 Area

CAMERA_USERNAME=admin
CAMERA_PASSWORD=your_password_here

# For 98-camera continuous monitoring use the lower-bandwidth substream.
# Main stream (0) gives more detail but can overwhelm one workstation/NVR.
CAMERA_SUBTYPE=1
CAMERA_CONNECT_STAGGER_SECONDS=0.15
RTSP_RECONNECT_SECONDS=3

# Optional second credential group for recorder/NVR IPs.
# Keep real passwords only in local .env; never commit them.
RECORDER_CAMERA_IPS=
RECORDER_CAMERA_USERNAME=admin
RECORDER_CAMERA_PASSWORD=

# Web-management ports used to read each NVR's real ChannelTitle names.
# Example format only; keep your actual recorder list in local .env.
RECORDER_HTTP_PORTS=

# ============================================================
# PRIMARY YOLO + BYTETRACK
# ============================================================
YOLO_MODEL=yolov8n.pt
TRACKING_CANDIDATE_CONFIDENCE=0.28
IOU_THRESHOLD=0.45
TARGET_CLASSES=0,1,2,3,5,7
# DISPLAYED-CAMERAS-ONLY MODE:
# only the 2 / 6 / 10 cameras currently shown on the Live page open RTSP
# and run YOLO/ByteTrack. All other configured cameras stay in STANDBY.
PAGED_CAMERA_MODE=1
MONITOR_ALL_CAMERAS=0
SHARED_AI_WORKERS=2
ACTIVE_CAMERA_LIMIT=10
AI_MODEL_IDLE_UNLOAD_SECONDS=15
AI_MAX_FPS=0.5
YOLO_IMGSZ=640
YOLO_DEVICE=
TRACK_TRAIL_LENGTH=18
JPEG_QUALITY=80

# ============================================================
# VEHICLE COUNTING
# ============================================================
COUNTING_ENABLED=1
COUNT_LINE_Y_RATIO=0.62
COUNT_MIN_TRACK_AGE=3
COUNT_MIN_CONFIDENCE=0.35

# ============================================================
# MYSQL
# ============================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cctv_ai
DB_USER=root
DB_PASSWORD=

# ============================================================
# ADVANCED MODELS
# ============================================================
HELMET_MODEL=models/helmet.pt
PLATE_MODEL=models/license_plate.pt
ROAD_DAMAGE_MODEL=models/road_damage.pt
ROAD_OBSTRUCTION_MODEL=models/road_obstruction.pt
ADVANCED_DETECTION_ENABLED=1
ADVANCED_EVERY_N_FRAMES=2
ADVANCED_CONFIDENCE=0.35

# ============================================================
# HELMET
# ============================================================
HELMET_OBSERVATION_CONFIDENCE=0.15
HELMET_CONFIDENCE=0.25
NO_HELMET_CONFIDENCE=0.20
NO_HELMET_FINAL_AVG_CONFIDENCE=0.20
HELMET_IMGSZ=960
HELMET_CONFIRM_FRAMES=2
HELMET_CONFIRM_WINDOW=4
STRICT_NO_HELMET_MIN_CONFIDENCE=0.20
STRICT_NO_HELMET_CONFIRM_FRAMES=2
STRICT_NO_HELMET_VOTE_RATIO=0.50
HELMET_CONFLICT_MARGIN=0.12
HELMET_HEAD_BOUNDS_REQUIRED=0
FALLBACK_NO_HELMET_CONFIDENCE=0.20
FALLBACK_NO_HELMET_FINAL_AVG_CONFIDENCE=0.20
FALLBACK_NO_HELMET_CONFIRM_FRAMES=2
FALLBACK_NO_HELMET_VOTE_RATIO=0.50

# ============================================================
# LICENSE PLATE + OCR
# ============================================================
PLATE_CONFIDENCE=0.20
PLATE_IMGSZ=960
PLATE_OCR_MIN_CONFIDENCE=0.18
PLATE_CACHE_SECONDS=8
PLATE_CONFIRM_READS=2
PLATE_CONFIRM_WINDOW=5
OCR_ENABLED=1

# ============================================================
# ROAD DAMAGE
# ============================================================
ROAD_DAMAGE_CONFIDENCE=0.15
ROAD_DISPLAY_CONFIDENCE=0.12
ROAD_DAMAGE_IMGSZ=960
ROAD_EVERY_N_FRAMES=4
ROAD_ROI_TOP_RATIO=0.22
ROAD_TILE_COLUMNS=2
ROAD_TILE_OVERLAP=0.18

# ============================================================
# ACCIDENT + ROAD OBSTRUCTION (NO CUSTOM .PT REQUIRED)
# ============================================================
INCIDENT_DETECTION_ENABLED=1
INCIDENT_EVERY_N_FRAMES=1
ACCIDENT_DETECTION_ENABLED=1
ACCIDENT_CONFIRM_FRAMES=2
ACCIDENT_MIN_MOTION_RATIO=0.004
ACCIDENT_STOP_RATIO=0.35
ACCIDENT_PROXIMITY_RATIO=0.80
ACCIDENT_IOU_THRESHOLD=0.01

ROAD_OBSTRUCTION_FALLBACK_ENABLED=1
OBSTRUCTION_ROI_TOP_RATIO=0.25
OBSTRUCTION_MIN_AREA_RATIO=0.01
OBSTRUCTION_CONFIRM_FRAMES=6
OBSTRUCTION_WARMUP_FRAMES=20
OBSTRUCTION_LEARNING_RATE=0.0005
INCIDENT_COOLDOWN_SECONDS=120

# ============================================================
# COOLDOWNS
# ============================================================
VIOLATION_COOLDOWN_SECONDS=90
ROAD_EVENT_COOLDOWN_SECONDS=120
